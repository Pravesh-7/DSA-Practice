2063: Vowels of all substrings
class Solution {
public:
    long long countVowels(string word) {
        int n = word.length();
        long long ans = 0;
        

        for(int i = 0; i < n; i++){
          if(word[i] == 'a'|| word[i] == 'e' || word[i] == 'i'|| word[i] == 'o'|| word[i] == 'u'){
            ans += (long long)(i+1)*(n-i);
          }
        }
        return ans;
    }
};
