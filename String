387: first unique character
class Solution {
public:
    int firstUniqChar(string s) {
        int n=s.length();
        vector<int>freq(26,0);
       
        for(char ch:s){
            freq[ch - 'a']++;
        }
        
        for(int i=0; i<n; i++){
            if(freq[s[i] -'a'] == 1) return i;
        }

        return -1;
    }
};
