            for(int j=0; j<n; j++){
                //for row check
                if(s1.find(matrix[i][j]) != s1.end()){
                    return false;
                }
                else{
                    s1.insert(matrix[i][j]);
                }
                // for col check
                if(s2.find(matrix[j][i]) != s2.end()){
