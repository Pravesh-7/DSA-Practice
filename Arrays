240: Search in 2D matrix II
class Solution {
public:
    bool searchMatrix(vector<vector<int>>& matrix, int target) {
        int m=matrix.size(), n=matrix[0].size();
        //start from top left corner
        int row=0 ,col=n-1;

        while(row < m && col >=0 ){
            if(target == matrix[row][col]) return true;

            else if(target < matrix[row][col]){
                col--; //move left cause current element is greater and we know entire col is also greater
            }

            else{
                row++; //move down cause curren el is smaller than we know the el to its left are also smaller so move down 
            }
        }
     return false;
        
    }
};
