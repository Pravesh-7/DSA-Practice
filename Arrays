Q:Row sum gfg
class Solution {
  public:
    vector<int> rowSum(vector<vector<int>>& mat) {
        // Code here
        int n = mat.size();
        vector<int>ans;
        
        for(int i=0; i<n; i++){
            int rowSum = 0;
            for(int j=0; j<mat[i].size(); j++){
                rowSum += mat[i][j];
            }
            
            ans.push_back(rowSum);
        }
        return ans;
    }
};
