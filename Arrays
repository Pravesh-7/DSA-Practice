2965: Repeating and missing values
class Solution {
public:
    vector<int> findMissingAndRepeatedValues(vector<vector<int>>& grid) {
        int n=grid.size();
       vector<int>ans;
       unordered_set<int>s;
       int a,b;
       int actualSum=0;//sum of given array
       

       for(int i=0;i<n;i++){
          for(int j=0;j<n;j++){
               actualSum +=grid[i][j];
              if(s.find(grid[i][j]) != s.end()){ //means if element is repeated then it is sure that it is already inserted in set
                 a=grid[i][j];
                 ans.push_back(a);
               }
               s.insert(grid[i][j]);
           }
        }
        int expSum=(n*n)*(n*n +1)/2;//sum of array without repeatition and missing value
        b=expSum+a-actualSum;
        ans.push_back(b);
        return ans;
    }
};
