Missing number in array
class Solution {
  public:
    int missingNum(vector<int>& arr) {
        // code here
        int n = arr.size()+1;
        int actualSum = 0;
        
        for(int i=0; i<n; i++){
            actualSum += arr[i];
        }
        
        int expSum = n*(n+1)/2;
        return(expSum-actualSum);
        
    }
};
