2661:First completely painted row and col
class Solution {
public:
    int firstCompleteIndex(vector<int>& arr, vector<vector<int>>& mat) {
        int row = mat.size(), col = mat[0].size();
        unordered_map<int,pair<int,int>>posMap;
        vector<int>rowCount(row, 0);
        vector<int>colCount(col, 0);

        for(int i=0;  i<row; i++){
            for(int j=0; j<col; j++){
                posMap[mat[i][j]] = {i,j};
            }
        }

        for(int i=0; i<arr.size(); i++){
          auto [r,c] = posMap[arr[i]];
          rowCount[r]++;
          colCount[c]++;

          if(rowCount[r] == col|| colCount[c] == row){
                return i;
            }
        }
        return -1;
    }
};

