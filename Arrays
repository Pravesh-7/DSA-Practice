74: Search in sorted matrix
class Solution {
  public:
  
    bool searchInRow(vector<vector<int>>& mat, int x, int row){
        
        int st = 0, end = mat[0].size();
        
        while(st <= end){
            int mid = st+(end-st)/2;
            
            if(x == mat[row][mid]) return true;
            
            if(x > mat[row][mid]){
                st = mid+1;
            }
            else{
                end = mid-1; 
            }
        }
        return false;
        
    }
  
    bool searchMatrix(vector<vector<int>> &mat, int x) {
        // code here
        int m = mat.size(); int n = mat[0].size();
        int stRow = 0, endRow = mat.size()-1;
        
        while(stRow <= endRow){
            int midRow = stRow+(endRow - stRow)/2;
            
            if(x >= mat[midRow][0] && x <= mat[midRow][n-1]){
               return  searchInRow(mat, x, midRow);
            }
            
            else if(x < mat[midRow][0]){
                endRow = midRow-1;
            }
            else stRow = midRow+1;
        }
        return false;
    }
};
