class Solution {
public:
    void moveZeroes(vector<int>& nums) {

        int k = 0;

        // Move non-zero elements forward
        for(int i = 0; i < nums.size(); i++) {

            if(nums[i] != 0) {
              swap(nums[i],nums[k]);
              k++;
            }
        }
    }
};
