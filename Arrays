59: Spiral Matrix II
class Solution {
public:
    vector<vector<int>> generateMatrix(int n) {
        vector<vector<int>>ans(n, vector<int>(n));
        
        int sRow = 0, eRow = n-1;
        int sCol = 0, eCol = n-1;

        int val = 1;
        while(sRow <= eRow &&  sCol <= eCol){
            //top
            for(int i=sCol; i<=eCol; i++){
               ans[sRow][i] = val++;
            } 
           
            //right
            for(int i= sRow+1; i<= eRow; i++){
                ans[i][eCol] = val++;
            }
            
            //bottom
            for(int i= eCol-1; i>= sCol; i--){
                if(sRow == eRow) break;
               ans[eRow][i] = val++;
            }
            
            //left
            for(int i= eRow-1; i>= sRow+1; i--){
                if(sCol == eCol) break;
              ans[i][sCol] = val++;
            }

            sRow++;sCol++;eRow--;eCol--;
            
        }
        return ans;
    }
};

