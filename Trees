1.Height of binary Tree
  class Solution {
    public:
      int height(Node* root) {
          // code here
          if(root == NULL) return -1;
          
          int leftHt = height(root->left);
          int rightHt = height(root->right);
          
          return max(leftHt, rightHt)+1;
      }
  };
