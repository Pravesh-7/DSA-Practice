116:Populate next right pointers

class Solution {
public:
    Node* connect(Node* root) {
       if(root == NULL || root->left == NULL){
         return root;
        }

        queue<Node*>q;
        q.push(root);
        q.push(NULL);

        Node* prev = NULL;
        while(q.size() > 0){
          Node* curr = q.front();
          q.pop();

          if(curr == NULL){
                if(q.size() == 0){
                    break;
                }
                q.push(NULL);
            }else{
               if(curr->left != NULL){
                 q.push(curr->left);
                }
              
               if(curr->right != NULL){
                q.push(curr->right);
               }

               if(prev != NULL){
                 prev->next = curr;
               }
            }

            prev = curr;

        }
     return root;
    }
};
