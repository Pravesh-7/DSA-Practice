907: Sum of subarray minimums
class Solution {
public:
    // finding next smaller el
    vector<int>findNSE(vector<int>& arr){
        int n = arr.size();
        vector<int>ans(n);
        stack<int>st;

        for(int i=n-1; i>=0; i--){
            while(st.size()>0 && arr[st.top()] >= arr[i]){
                st.pop();
            }
            ans[i] = st.empty() ? n: st.top();
            st.push(i);
        }
        return ans;
    }

    // find previous smaller el
    vector<int>findPSE(vector<int>& arr){
        int n = arr.size();
        vector<int>ans(n);
        stack<int>st;

        for(int i=0; i<n; i++){
            while(st.size()>0 && arr[st.top()] > arr[i]){
                st.pop();
            }
            ans[i] = st.empty() ? -1: st.top();
            st.push(i);
        }
        return ans;
    }
    int sumSubarrayMins(vector<int>& arr) {
        vector<int>nse = findNSE(arr);
        vector<int>pse = findPSE(arr);

        int n = arr.size();
        int ans = 0;
        int mod = 1e9+7;

        for(int i=0; i<n; i++){
            int left = i - pse[i];
            int right = nse[i] - i;

            long long freq = left*right*1LL;
            long long val = (freq*arr[i]*1LL) % mod;

            ans = (ans+val) % mod;
        }
        return ans; 
